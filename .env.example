# ==============================================================================
# Renaissance Group HR Portal — Production Environment Configuration (.env)
# IMPORTANT: Never commit actual secret keys or credentials to public Git repositories!
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV="production"

# Database Connection (PostgreSQL - Cloud SQL / Supabase / Neon / Self-Hosted)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/hr_portal_db"

# Session & Cryptographic Token Security
# Generate high-entropy 64+ char random strings for production deployments:
# Example: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET="rg-hr-secure-entropy-key-2026-renaissance-portal"
AUTH_SALT="rg-hr-pbkdf2-salt-2026-production"

# Optional Cloud & External Application Integration
APP_URL="https://ais-pre-eczu67rzzpk2esvq42hfvw-850937953254.asia-southeast1.run.app"
GEMINI_API_KEY=""

# Supabase Client Integration (Optional - Project Settings > API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
